<odoo>
    <record id="rule_project_task_scope_manager" model="ir.rule">
        <field name="name">Task Scope Manager</field>
        <field name="model_id" ref="model_project_task_scope" />
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_project_task_scope_user" model="ir.rule">
        <field name="name">Task Scope User Read</field>
        <field name="model_id" ref="model_project_task_scope" />
        <field name="groups" eval="[(4, ref('project.group_project_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
