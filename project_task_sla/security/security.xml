<odoo>
    <record id="model_project_task_sla_rule_manager" model="ir.rule">
        <field name="name">SLA Manager Rule</field>
        <field name="model_id" ref="model_project_task_sla" />
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="model_project_task_sla_rule_user" model="ir.rule">
        <field name="name">SLA User Read Rule</field>
        <field name="model_id" ref="model_project_task_sla" />
        <field name="groups" eval="[(4, ref('project.group_project_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
