<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_hr_employee_form_ts_cutoff" model="ir.ui.view">
    <field name="name">hr.employee.form.ts.cutoff</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Timesheet Cutoff">
          <field name="ts_cutoff_override" />
          <group invisible="not ts_cutoff_override">
            <field name="ts_cutoff_enabled_emp" />
            <field name="ts_cutoff_hour_emp" />
            <field name="ts_cutoff_minute_emp" />
            <field name="ts_block_start_after_cutoff_emp" />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
