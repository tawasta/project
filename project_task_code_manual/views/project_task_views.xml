<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_task_form2_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit.manual.code</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="display_in_project" position="after">
                <field name="code" />
            </field>
        </field>
    </record>
    <record id="view_task_tree2_inherit" model="ir.ui.view">
        <field name="name">project.task.tree.inherit.manual.code</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" optional="show" />
            </field>
        </field>
    </record>
    <record id="view_task_kanban_inherit" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.manual.code</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" />
            </field>

            <xpath
                expr="//div[hasclass('o_kanban_record_top')]//strong[hasclass('o_kanban_record_title')]"
                position="after"
            >
                <span style="display: block; margin-top: 4px;">
                    <field name="code" />
                </span>
            </xpath>
        </field>
    </record>
    <record id="view_task_search_form_inherit" model="ir.ui.view">
        <field name="name">project.task.search.inherit.manual.code</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self),
                    ('code', 'ilike', self)]
                </attribute>
            </field>
        </field>
    </record>
</odoo>
