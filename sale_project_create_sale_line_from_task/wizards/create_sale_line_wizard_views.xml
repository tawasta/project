<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_create_line_from_task_wizard_form" model="ir.ui.view">
        <field name="name">sale.create.line.from.task.wizard.form</field>
        <field name="model">sale.create.line.from.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sale Order Line from Task">
                <sheet>
                    <group>
                        <field name="task_id" readonly="1" />
                        <field name="partner_id" readonly="1" />
                        <field
                            name="sale_order_id"
                            domain="[('commercial_partner_id.id', 'parent_of', partner_id), ('state', '=', 'sale')]"
                            options="{'no_create': True, 'no_edit': True,'no_open': True}"
                        />
                        <field
                            name="product_id"
                            options="{'no_create': True, 'no_edit': True,'no_open': True}"
                        />
                    </group>
                    <footer>
                        <button
                            string="Create"
                            type="object"
                            name="action_create_sale_line"
                            class="btn-primary"
                        />
                        <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
