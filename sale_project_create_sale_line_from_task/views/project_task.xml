<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_sale_create_line_from_task_wizard" model="ir.actions.act_window">
        <field name="name">Create Sale Order Line from Task</field>
        <field name="res_model">sale.create.line.from.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_create_line_from_task_wizard_form" />
        <field name="target">new</field>
    </record>

    <record id="view_task_form2_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sale.create.line</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <button
                    name="%(action_sale_create_line_from_task_wizard)d"
                    type="action"
                    string="Create New Sale Order Line"
                    context="{'default_task_id': id, 'default_partner_id': partner_id}"
                    invisible="not allow_billable or not project_id or not partner_id or sale_line_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
