<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <!-- Wizardin lomake -->
  <record id="view_installation_checklist_wizard_form" model="ir.ui.view">
    <field name="name">installation.checklist.wizard.form</field>
    <field name="model">installation.checklist.wizard</field>
    <field name="arch" type="xml">
      <form string="Installation Checklist" create="false" edit="false">
        <sheet>
          <group>
            <field name="installation_id" readonly="1"/>
          </group>
          <field name="line_ids" nolabel="1"
                context="{}"
                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
            <tree string="Checklist" create="0" delete="0" editable="bottom">
                <!-- Pidä item_id näkymässä piilossa -->
                <field name="item_id" invisible="1"/>
                <field name="name" readonly="1"/>
                <field name="module_id" readonly="1"/>
                <!-- Tämä on ainoa muokattava -->
                <field name="is_done"/>
                <field name="done_by" readonly="1"/>
                <field name="done_at" readonly="1"/>
            </tree>
        </field>
        </sheet>
        <footer>
          <button name="action_apply" type="object" string="Tallenna" class="btn-primary"/>
          <button string="Sulje" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>


</odoo>
