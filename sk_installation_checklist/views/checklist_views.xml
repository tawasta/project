<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_installation_checklist_item_tree" model="ir.ui.view">
    <field name="name">installation.checklist.item.tree</field>
    <field name="model">installation.checklist.item</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle" />
        <field name="name" />
        <field name="module_id" />
        <field name="is_mandatory" />
        <field name="validation_status" />
        <field name="is_done" />
        <field name="done_by" />
        <field name="done_at" />
      </tree>
    </field>
  </record>

  <record id="view_installation_checklist_item_form" model="ir.ui.view">
    <field name="name">installation.checklist.item.form</field>
    <field name="model">installation.checklist.item</field>
    <field name="arch" type="xml">
      <form string="Checklist Item">
        <sheet>
          <group>
            <field name="name" />
            <field name="installation_id" readonly="1" />
            <field name="module_id" readonly="1" />
            <field name="is_mandatory" readonly="1" />
          </group>
          <group>
            <field name="validation_status" readonly="1" />
            <field name="is_done" />
          </group>
          <notebook>
            <page string="Description">
              <field name="description" nolabel="1" />
            </page>
            <page string="History">
              <group>
                <field name="done_by" readonly="1" />
                <field name="done_at" readonly="1" />
              </group>
              <field name="message_ids" widget="mail_thread" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_installation_checklist_items" model="ir.actions.act_window">
    <field name="name">Checklist Items</field>
    <field name="res_model">installation.checklist.item</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="domain">[]</field>
  </record>

  <menuitem
        id="checklist_menu"
        name="Checklist"
        parent="software_knowledge_base.root_menu"
        sequence="20"
    />
    <menuitem
        id="checklist_items_menu"
        parent="checklist_menu"
        action="action_installation_checklist_items"
        sequence="10"
    />
</odoo>
